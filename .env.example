# =============================================================================
# NorteDesk — variáveis de ambiente
# Copie para .env e ajuste. Nunca commite segredos.
# =============================================================================

# --- Servidor de sinalização (apps/signaling) ---
# Em PaaS (Render), PORT é injetado automaticamente e tem prioridade.
# SIGNALING_PORT é usado só em desenvolvimento local.
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=8787
PORT=

# URL pública do WebSocket (documentação / referência). Em produção use WSS.
# Exemplo local: ws://127.0.0.1:8787
# Exemplo Render: wss://SEU-SERVICO.onrender.com
# (substitua SEU-SERVICO pela URL pública exibida no painel do Render)
SIGNALING_PUBLIC_URL=ws://127.0.0.1:8787

# TTL do código temporário (ms)
CODE_TTL_MS=600000

# Limites de segurança
MAX_CODE_ATTEMPTS_PER_IP=10
CODE_ATTEMPT_WINDOW_MS=60000
MAX_REQUESTS_PER_HOST=5
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=45000
REQUEST_TIMEOUT_MS=60000

# --- ICE / STUN / TURN ---
# STUN ajuda na descoberta de candidatos. NÃO garante conexão entre redes diferentes.
STUN_URLS=stun:stun.l.google.com:19302

# TURN (opcional). Sem TURN configurado, conexões entre redes distintas NÃO estão garantidas.
# Nunca embuta TURN_SECRET no aplicativo Electron distribuído.
# TURN_URLS=turn:turn.exemplo.com:3478?transport=udp,turn:turn.exemplo.com:3478?transport=tcp
# TURN_SECRET=troque-por-segredo-forte-compartilhado-com-coturn
# TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Cliente Electron (apps/desktop) — embutida no build Vite ---
# Desenvolvimento local:
VITE_SIGNALING_URL=ws://127.0.0.1:8787
# Produção (obrigatório no build do instalador): use a URL WSS do Render, por exemplo:
# VITE_SIGNALING_URL=wss://SEU-SERVICO.onrender.com
